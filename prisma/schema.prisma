generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Chain {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  brandColor String
  logoUrl    String
  stores     Store[]
  managers   Manager[]
  sales      Sale[]
  fliers     Flier[]
}

model Store {
  id      String @id @default(cuid())
  chainId String
  chain   Chain  @relation(fields: [chainId], references: [id], onDelete: Cascade)
  name    String
  city    String
  address String
  mapsUrl String

  @@index([city])
}

model Manager {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  chainId      String
  chain        Chain  @relation(fields: [chainId], references: [id], onDelete: Cascade)
}

enum Category {
  BULMET
  MISH
  PEME_PERIME
  BUKE_BRUMERA
  PIJE
  EMBELSIRA_SNACKS
  HIGJIENE_PASTRIM
  USHQIME_BAZE
}

enum SizeUnit {
  G
  KG
  ML
  L
  COPE
}

model Sale {
  id            String   @id @default(cuid())
  chainId       String
  chain         Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  // set when the offer was published from an uploaded flier
  flierId       String?
  flier         Flier?   @relation(fields: [flierId], references: [id], onDelete: SetNull)
  productName   String
  // accent-folded lowercase copy of productName (ë→e, ç→c) for accent-insensitive search
  searchName    String
  category      Category
  sizeValue     Float
  sizeUnit      SizeUnit
  oldPriceCents Int
  newPriceCents Int
  imageUrl      String
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([searchName])
  @@index([chainId])
  @@index([startsAt, endsAt])
  @@index([flierId])
}

enum FlierStatus {
  PROCESSING
  REVIEW
  PUBLISHED
  FAILED
}

model Flier {
  id        String      @id @default(cuid())
  chainId   String
  chain     Chain       @relation(fields: [chainId], references: [id], onDelete: Cascade)
  status    FlierStatus @default(PROCESSING)
  // flier-level validity extracted from the pages; prefills the review form
  startsAt  DateTime?
  endsAt    DateTime?
  error     String?
  createdAt DateTime    @default(now())
  pages     FlierPage[]
  drafts    DraftSale[]
  sales     Sale[]

  @@index([chainId, createdAt])
}

enum FlierPageStatus {
  PENDING
  DONE
  FAILED
}

model FlierPage {
  id       String          @id @default(cuid())
  flierId  String
  flier    Flier           @relation(fields: [flierId], references: [id], onDelete: Cascade)
  pageNo   Int
  imageUrl String
  status   FlierPageStatus @default(PENDING)

  @@unique([flierId, pageNo])
}

// AI-extracted offer awaiting manager validation — nothing here is public
model DraftSale {
  id            String    @id @default(cuid())
  flierId       String
  flier         Flier     @relation(fields: [flierId], references: [id], onDelete: Cascade)
  pageNo        Int
  productName   String
  category      Category?
  sizeValue     Float?
  sizeUnit      SizeUnit?
  oldPriceCents Int?
  newPriceCents Int
  // the printed "-25%" badge — used to cross-check the struck-through old price
  discountPercent Int?
  createdAt     DateTime  @default(now())
}
