# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (Docker container from README):
DATABASE_URL="postgresql://zbritje:zbritje_dev@localhost:5433/zbritje"
# Production (Supabase -> Connect -> Session pooler):
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign the manager session cookie. Generate a long random one
# for production, e.g.:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# ─── Image storage ───────────────────────────────────────────────────────────
# "local"    -> saves uploads to public/uploads (dev only; not persistent on Vercel)
# "supabase" -> uploads to a public Supabase Storage bucket (production)
STORAGE_DRIVER="local"

# Required only when STORAGE_DRIVER="supabase":
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# SUPABASE_STORAGE_BUCKET="zbritje-images"

# ─── AI flier extraction ─────────────────────────────────────────────────────
# Personal OpenAI API key (platform.openai.com). Without it, everything works
# except reading uploaded fliers.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o"   # default; gpt-4o-mini is cheaper, slightly less accurate
