# Lokale (Docker Postgres) — në produksion vendos connection string-un e Supabase
DATABASE_URL="postgresql://zbritje:zbritje_dev@localhost:5433/zbritje"

# Sekret për nënshkrimin e session cookie-t (ndrysho në produksion)
SESSION_SECRET="dev-only-zbritje-session-secret-ndrysho-ne-prod"

# Ruajtja e imazheve: "local" (disk, vetëm dev) ose "supabase" (prodhim)
STORAGE_DRIVER="local"

# Vetëm për STORAGE_DRIVER="supabase":
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="zbritje-images"
